pub fn ComposableContext.Main() {
    let toolbar_entries = signal([])

    Stack {
        Box(width = 200.dp, height = 100.dp) {
            Text("Test Overlay")
        }

        Col {
            Toolbar(entries = toolbar_entries)
            Button() {
                Text("Add entry")
            }
            Button() {
                Text("Remove entry")
            }
        }
    }
}
